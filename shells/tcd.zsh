# Generated by `tcd init zsh`. Source only into an interactive Zsh.
[[ -o interactive ]] || return 0

function _tcd_back() {
    emulate -L zsh
    if (( ! ${#_tcd_origins} )); then
        print -u2 -r -- 'tcd: no pending return'
        return 1
    fi
    local origin=${_tcd_origins[-1]}
    _tcd_origins[-1]=() _tcd_targets[-1]=() _tcd_running[-1]=()
    if builtin cd -- "$origin"; then
        if (( ${#_tcd_running} )); then _tcd_running[-1]=0; fi
        return 0
    fi
    print -u2 -r -- "tcd: could not return to $origin; return canceled"
    _tcd_origins=() _tcd_targets=() _tcd_running=()
    return 1
}

function tcd() {
    emulate -L zsh
    if [[ $# == 1 && $1 == --cancel ]]; then
        _tcd_origins=() _tcd_targets=() _tcd_running=()
        return 0
    fi
    if [[ $# == 1 && $1 == --status ]]; then
        if (( ${#_tcd_origins} )); then
            _tcd_running[-1]=0
            print -r -- "tcd: return to ${_tcd_origins[-1]} | depth: ${#_tcd_origins}"
        else
            print -r -- 'tcd: no pending return'
        fi
        return 0
    fi
    if [[ $# != 1 || ( $1 == --* && $1 != --back ) ]]; then
        print -u2 -r -- 'tcd: expected one directory or --status, --back, --cancel'
        return 2
    fi
    if (( ! _tcd_in_line )); then
        print -u2 -r -- 'tcd: interactive command only; use cd in startup files'
        return 2
    fi
    if [[ $1 == --back ]]; then
        _tcd_back
        return $?
    fi
    local origin=$PWD
    builtin cd -- "$1" || return $?
    _tcd_origins+=("$origin")
    _tcd_targets+=("$PWD")
    _tcd_running+=(0)
}

function _tcd_preexec() {
    emulate -L zsh
    _tcd_in_line=1
    if (( ${#_tcd_running} )); then
        if [[ $PWD != "${_tcd_targets[-1]}" ]]; then
            _tcd_origins=() _tcd_targets=() _tcd_running=()
        else
            _tcd_running[-1]=1
        fi
    fi
    return 0
}

function _tcd_precmd() {
    emulate -L zsh
    _tcd_in_line=0
    if (( ${#_tcd_origins} )); then
        if [[ $PWD != "${_tcd_targets[-1]}" ]]; then
            _tcd_origins=() _tcd_targets=() _tcd_running=()
        elif (( _tcd_running[-1] )); then
            _tcd_back
        fi
    fi
    # Returning nonzero from a hook would suppress subsequent precmd hooks.
    # Zsh preserves the command's status for the prompt independently of this.
    return 0
}

if (( ! ${+_tcd_installed} )); then
    typeset -g _tcd_installed=1 _tcd_in_line=0
    typeset -ga _tcd_origins=() _tcd_targets=() _tcd_running=()
    autoload -Uz add-zsh-hook
    add-zsh-hook preexec _tcd_preexec
    add-zsh-hook precmd _tcd_precmd
fi
